; pad_orbit.tas — original TritARM guest. Not a Nintendo product.
    MOV r6, #64
    LSL r6, r6, #24
    MOV r5, r6
    MOV r4, #32
    ADD r4, r6, r4
    MOV r0, #20
    MOV r1, #10
    MOV r2, #2
    MOV r3, #1
    MOV r8, #72
    STRB r8, [r5]
    MOV r8, #73
    STRB r8, [r5]
    MOV r8, #10
    STRB r8, [r5]
loop:
    STR r0, [r4]
    MOV r7, #4
    ADD r7, r4, r7
    STR r1, [r7]
    ADD r0, r0, r2
    ADD r1, r1, r3
    CMP r0, #90
    BGT flipx
    CMP r0, #5
    BLT flipx
    B checky
flipx:
    MOV r9, #0
    SUB r2, r9, r2
checky:
    CMP r1, #90
    BGT flipy
    CMP r1, #5
    BLT flipy
    B loop
flipy:
    MOV r9, #0
    SUB r3, r9, r3
    B loop
